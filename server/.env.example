# Copy to server/.env and fill in real values. Never commit the filled file.

PORT=5000

MONGO_URI=
GROQ_API_KEY=
OPENWEATHER_API_KEY=
JWT_SECRET=

# Comma-separated list of allowed CORS origins (e.g. https://hawkvision.onrender.com)
FRONTEND_URL=

# Absolute path to the Python interpreter that has ultralytics/opencv installed
PYTHON_PATH=

# Network stream URL of the drone camera (leave empty to disable live drone mode)
DRONE_STREAM_URL=

# Path to the YOLO weights used for drone person detection
DRONE_MODEL_PATH=

# Path to the YOLO weights used for victim image detection (falls back to DRONE_MODEL_PATH)
VICTIM_MODEL_PATH=
